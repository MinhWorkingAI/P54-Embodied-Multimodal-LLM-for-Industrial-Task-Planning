# Select which LLM backend to use for instruction parsing.
# Options: openai | gemini | deepseek | huggingface
LLM_BACKEND=huggingface

OPENAI_API_KEY=your-openai-api-key-here
# Which OpenAI model to use. gpt-4o gives the best parsing accuracy.
# Options: gpt-4o | gpt-4o-mini | gpt-4-turbo
OPENAI_MODEL=gpt-4o
# Sampling temperature. 0.0 = fully deterministic, recommended for structured output.
OPENAI_TEMPERATURE=0.0

GEMINI_API_KEY=your-gemini-api-key-here
# Options: gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.0

DEEPSEEK_API_KEY=your-deepseek-api-key-here
# Do NOT use deepseek-reasoner — it does not support structured JSON output.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.0

# Local model via HuggingFace — no API key needed, runs on your own hardware.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Where to load the model. auto lets torch decide based on available hardware.
# Options: auto | cpu | cuda | mps
HF_DEVICE=auto
# Maximum tokens the model may generate per call.
HF_MAX_TOKENS=512
# Load in 4-bit quantisation to reduce VRAM usage. Requires bitsandbytes package.
# Options: TRUE | FALSE
HF_LOAD_IN_4BIT=TRUE

# Set to true to use a live PyBullet simulation for scene detection 
# Set to false to read the scene from a static JSON file in drafts/.
# Options: true | false
USE_LIVE_SIMULATION=false

# PyBullet connection mode. Only used when USE_LIVE_SIMULATION=true.
# DIRECT runs headless with no window — use this for the pipeline.
# GUI opens a 3D physics window — use this for visual debugging only.
# Options: DIRECT | GUI
SIMULATION_MODE=DIRECT

# Primary vision detector for the live simulation.
# Leave empty to use ground truth (exact positions read from PyBullet physics).
# colour requires only OpenCV. yolo and grounded_sam require additional packages.
# Options: (empty) | colour | yolo | grounded_sam
VISION_DETECTOR=

# Robot controller used in Stage 4 execution.
# mock uses MockRobot — no real arm, no PyBullet URDF required.
# Real robot options are available from Phase 3 onwards.
# Options: mock | franka | kuka | ur5
ROBOT_MODEL=mock
