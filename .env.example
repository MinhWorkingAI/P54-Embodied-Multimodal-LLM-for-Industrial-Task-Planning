# Select which LLM backend to use for instruction parsing.
# Options: openai | gemini | deepseek | huggingface
LLM_BACKEND=huggingface

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0                  # Sampling temperature. 0.0 = fully deterministic, recommended for structured output.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.0                   # Sampling temperature. 0.0 = fully deterministic, recommended for structured output.

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat             # Do NOT use deepseek-reasoner — it does not support structured JSON output.
DEEPSEEK_TEMPERATURE=0.0                 # Sampling temperature. 0.0 = fully deterministic, recommended for structured output.    


# Local model via HuggingFace 
HF_DEVICE=auto                           # Options: auto | cpu | cuda | mps
HF_MAX_TOKENS=512                        # Maximum tokens the model may generate per call.
# Load in 4-bit quantisation to reduce VRAM usage. Requires bitsandbytes package.
# Options: TRUE | FALSE
HF_LOAD_IN_4BIT=TRUE

# Set to true to use a live PyBullet simulation for scene detection
# Set to false to read the scene from a static JSON file in drafts/.
USE_LIVE_SIMULATION=false           # Options: true | false


# PyBullet connection mode. Only used when USE_LIVE_SIMULATION=true.
# DIRECT runs headless with no window — use this for the pipeline.
# GUI opens a 3D physics window — use this for visual debugging only.
SIMULATION_MODE=DIRECT          # Options: DIRECT | GUI

# Primary vision detector for the live simulation.
# Leave empty to use ground truth (exact positions read from PyBullet physics).
# colour requires only OpenCV. yolo and grounded_sam require additional packages.
# Options: (empty) | colour | yolo | grounded_sam
VISION_DETECTOR=colour

# Robot controller used in Stage 4 execution.
# mock uses MockRobot — no real arm, no PyBullet URDF required.
# Real robot options are available from Phase 3 onwards.
# Options: mock | franka | kuka | ur5
ROBOT_MODEL=mock




# YOLOv8 detector settings. Only used when VISION_DETECTOR=yolo.
# Weights file loaded from simulation_backend/vision/detection_models/.
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONFIDENCE=0.25            # Minimum detection confidence (0.0–1.0). Lower catches more objects but adds false positives.
YOLO_IOU=0.45
# Options: cpu | cuda | mps | auto
YOLO_DEVICE=cpu                 # Inference device. 
# Inference image size in pixels. Must be a multiple of 32.
YOLO_IMGSZ=640                  



# Colour HSV detector settings. Only used when VISION_DETECTOR=colour.
COLOUR_MIN_AREA=30
# Expected pixel area of a fully visible, unoccluded block face.
# Confidence score = min(detected_area / expected_area, 1.0).
COLOUR_EXPECTED_AREA=100
# Half-size of the depth sampling patch around the detected centroid (pixels).
COLOUR_DEPTH_RADIUS=3


